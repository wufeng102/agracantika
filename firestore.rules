rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /artifacts/{appId} {

      function isSignedIn() { return request.auth != null; }

      function myRole() {
        return get(/databases/$(database)/documents/artifacts/$(appId)/public/data/users/$(request.auth.uid)).data.role;
      }
      function isAdminProject() { return isSignedIn() && myRole() == 'admin_project'; }
      function isAdminMarket()  { return isSignedIn() && myRole() == 'admin_marketplace'; }

      // Profil pengguna (hanya admin). Tidak ada lagi pendaftaran akun pembeli
      // di aplikasi (situs tidak melayani transaksi) — akun admin_project /
      // admin_marketplace dibuat manual lewat Firebase Console:
      // Authentication > Add user, lalu buat dokumen di sini dengan UID yang
      // sama berisi field role yang sesuai.
      match /public/data/users/{uid} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow write: if false; // isi/ubah role HANYA lewat Firebase Console, bukan dari app
      }

      // Katalog produk — portal katalog saja (tidak ada transaksi di sini).
      // Publik boleh baca; hanya admin_marketplace yang boleh menulis.
      match /public/data/products/{productId} {
        allow read: if true;
        allow write: if isAdminMarket();
      }

      // Artikel edukasi/berita — publik boleh baca, hanya admin_project
      // yang boleh menulis.
      match /public/data/posts/{postId} {
        allow read: if true;
        allow write: if isAdminProject();
      }
    }
  }
}
